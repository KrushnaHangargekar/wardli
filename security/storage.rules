rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Wardrobe photos are strictly private to the authenticated owner
    match /users/{userId}/garments/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
